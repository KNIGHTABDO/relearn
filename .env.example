# Google OAuth (for Google AI Pro student auth)
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# These are set automatically by the client-side auth:
# - google_access_token (stored in localStorage)
# - google_refresh_token (stored in localStorage)
