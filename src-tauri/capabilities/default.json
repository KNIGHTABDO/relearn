{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/nicegui/static/tauri-schema.json",
  "identifier": "default",
  "description": "Default permissions for ReLearn",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "opener:default",
    "oauth:default",
    "oauth:allow-start-oauth-server",
    "oauth:allow-github-device-code",
    "oauth:allow-github-poll-token",
    "oauth:allow-google-exchange-token",
    "oauth:allow-google-refresh-token"
  ]
}
